{
  "name": "health-water-app",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build --mode web",
    "build:native": "npm run typecheck && vite build --mode native",
    "build:cloud": "npm run typecheck && vite build --mode cloud",
    "build:native-cloud": "npm run typecheck && vite build --mode native-cloud",
    "assets:pose": "node scripts/prepare-pose.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rules": "node scripts/test-rules.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "preview": "vite preview",
    "sync:android": "npm run build:native && npx cap sync android",
    "build:apk": "npm run sync:android && node scripts/android-build.mjs",
    "build:apk:cloud": "npm run build:native-cloud && npx cap sync android && node scripts/android-build.mjs testDebugUnitTest assembleDebug -PwaterVersionCode=310 -PwaterVersionName=3.1.0",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "firebase": "^12.14.0",
    "idb": "^8.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.4",
    "firebase-tools": "^15.8.0",
    "globals": "^17.6.0",
    "jsdom": "^27.4.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
