rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function date(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function oldSeq(uid) { return exists(/databases/$(database)/documents/accounts/$(uid)) ? get(/databases/$(database)/documents/accounts/$(uid)).data.get('seq', 0) : 0; }
    function migrated(uid) { return exists(/databases/$(database)/documents/accounts/$(uid)) && get(/databases/$(database)/documents/accounts/$(uid)).data.get('migrated', false); }
    function validEntity(uid, id, d) {
      let common = ['id','profile','kind','amountMl','date','version','updatedAt','deleted','changeSeq'];
      return d.id == id && d.profile == 'user:' + uid && d.version is int && d.version > 0
        && d.updatedAt is int && d.updatedAt >= 0 && d.deleted is bool && date(d.date)
        && d.amountMl is int && d.amountMl > 0 && d.amountMl <= 100000
        && d.changeSeq is int && d.changeSeq == oldSeq(uid) + 1
        && getAfter(/databases/$(database)/documents/accounts/$(uid)).data.seq == d.changeSeq
        && ((d.kind == 'goal' && d.keys().hasOnly(common))
          || (d.kind == 'entry' && d.keys().hasOnly(common.concat(['occurredAt','timeZone','source'])) && d.occurredAt is int && d.occurredAt >= 0 && d.timeZone is string && d.timeZone.size() <= 80 && d.source in ['manual','pose'])
          || (d.kind == 'legacy' && d.keys().hasOnly(common.concat(['originalDate','origin'])) && date(d.originalDate) && d.origin is string && d.origin.size() <= 300));
    }
    match /accounts/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['seq','migrated']) && request.resource.data.get('seq', 0) in [0,1] && request.resource.data.get('migrated', false) is bool;
      allow update: if owner(uid) && request.resource.data.keys().hasOnly(['seq','migrated'])
        && request.resource.data.get('seq', 0) in [resource.data.get('seq', 0), resource.data.get('seq', 0) + 1]
        && request.resource.data.get('migrated', false) is bool && (!resource.data.get('migrated', false) || request.resource.data.get('migrated', false));
      allow delete: if false;
      match /entities/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) && validEntity(uid, id, request.resource.data) && request.resource.data.version == 1;
        allow update: if owner(uid) && validEntity(uid, id, request.resource.data) && request.resource.data.version == resource.data.version + 1 && (!resource.data.deleted || request.resource.data.deleted);
        allow delete: if false;
      }
      match /operations/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) && request.resource.data.keys().hasOnly(['entityId','version','createdAt'])
          && request.resource.data.entityId is string && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/accounts/$(uid)/entities/$(request.resource.data.entityId)).data.version == request.resource.data.version;
        allow update, delete: if false;
      }
      match /preferences/leaderboard {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['enabled','nickname'])
          && request.resource.data.enabled is bool && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 24;
      }
    }
    match /leaderboard/{uid} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit != null && request.query.limit <= 20;
      allow create, update: if owner(uid) && getAfter(/databases/$(database)/documents/accounts/$(uid)/preferences/leaderboard).data.enabled == true
        && request.resource.data.keys().hasOnly(['nickname','weekStart','monthStart','weekDays','monthDays','updatedAt'])
        && request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 24
        && !request.resource.data.nickname.matches('.*@.*') && date(request.resource.data.weekStart) && date(request.resource.data.monthStart)
        && request.resource.data.weekDays is int && request.resource.data.weekDays >= 0 && request.resource.data.weekDays <= 7
        && request.resource.data.monthDays is int && request.resource.data.monthDays >= 0 && request.resource.data.monthDays <= 31
        && request.resource.data.updatedAt == request.time;
      allow delete: if owner(uid);
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && !migrated(uid) && request.resource.data.keys().hasOnly(['nickname','email','createdAt']);
      match /records/{dateKey} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && !migrated(uid) && request.resource.data.keys().hasOnly(['date','amount','updatedAt']) && request.resource.data.date == dateKey && request.resource.data.amount is number && request.resource.data.amount >= 0;
      }
      match /settings/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && !migrated(uid) && request.resource.data.keys().hasOnly(['goal','updatedAt']);
      }
    }
  }
}
